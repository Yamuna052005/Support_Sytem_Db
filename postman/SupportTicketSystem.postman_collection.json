{
  "info": {
    "name": "Support Ticket Management System API",
    "description": "Run the whole collection in order with the Collection Runner. Set the `baseUrl` collection variable to your local or deployed API (including /api). Requires the seed data from database/seed.sql.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "otherCustomerToken",
      "value": ""
    },
    {
      "key": "agentToken",
      "value": ""
    },
    {
      "key": "newUserToken",
      "value": ""
    },
    {
      "key": "newEmail",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register customer (success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"Password123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"newEmail\", \"postman_\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response is JSON\", () => pm.response.to.be.json);",
                  "const d = pm.response.json();",
                  "pm.test(\"Role is customer\", () => pm.expect(d.user.role).to.eql(\"customer\"));",
                  "pm.test(\"No password hash leaked\", () => pm.expect(d.user).to.not.have.property(\"password_hash\"));",
                  "pm.collectionVariables.set(\"newUserToken\", d.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - invalid input (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Has field errors\", () => pm.expect(pm.response.json().errors).to.be.an(\"array\").that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
