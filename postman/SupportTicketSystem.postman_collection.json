            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carol Again\",\n  \"email\": \"carol@example.com\",\n  \"password\": \"Password123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
